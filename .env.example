# Which Provider answers Jev questions: mock | typesafe | jev_agent
# mock = zero cost, zero network calls, always available. This is the default
# and what the deployed public demo should stay on.
JEV_PROVIDER=mock

JEV_MODEL=jev-latest

# Only needed if JEV_PROVIDER=typesafe. Get one from https://console.typesafe.ai (waitlist)
# or the free Vercel AI Gateway window (see README).
TYPESAFE_API_KEY=

# Only needed if JEV_PROVIDER=jev_agent. Free unofficial relay, get a key from
# https://jev-agent.com/api-access. No uptime SLA, ~5k input tokens/month free.
# Not affiliated with TypeSafe AI — use for local demo captures only, not production.
JEV_AGENT_KEY=
